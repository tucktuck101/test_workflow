FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* frontend/tsconfig.json frontend/vite.training.config.ts frontend/training.html frontend/src ./
RUN npm install && npm run build:training

FROM nginx:alpine
COPY --from=build /app/dist-training /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
