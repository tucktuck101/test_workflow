FROM python:3.11-slim

WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY training /app/training
COPY tools /app/tools

ENV TRAIN_OUTPUT=/app/artifacts \
    TRAIN_ARTIFACT_NAME=model.bin \
    TRAIN_EPOCHS=10 \
    TRAIN_SEED=0 \
    TRAIN_DEVICE=cpu \
    TRAIN_BOARD_SIZE=10 \
    TRAIN_ALLOW_ADJACENT=true

VOLUME ["/app/artifacts", "/app/configs"]

ENTRYPOINT ["python", "-m", "training.trainer"]
