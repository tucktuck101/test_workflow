{
  "name": "battleship-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:training": "tsc && vite build --config vite.training.config.ts",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "js-yaml": "^4.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "vitest": {
    "coverage": {
      "provider": "v8",
      "thresholds": {
        "statements": 70,
        "branches": 70,
        "functions": 70,
        "lines": 70
      },
      "exclude": [
        "src/main.tsx",
        "src/types.ts"
      ]
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.14",
    "jsdom": "^25.0.1",
    "playwright": "^1.57.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.1",
    "vitest": "^4.0.14"
  }
}
